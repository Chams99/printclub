# Public origins
PRINTCLUB_WEB_HOST=printclub.chames.tn
PRINTCLUB_API_HOST=api.printclub.chames.tn
VITE_SERVER_URL=https://api.printclub.chames.tn
BETTER_AUTH_URL=https://api.printclub.chames.tn
CORS_ORIGIN=https://printclub.chames.tn

# Build-time public Google client id (the matching secret stays server-only)
VITE_GOOGLE_CLIENT_ID=

# Server secrets: generate unique values and never commit this file.
BETTER_AUTH_SECRET=replace-with-a-unique-64-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification delivery (Resend; keep the API key server-only)
RESEND_API_KEY=
EMAIL_FROM=printclub <no-reply@printclub.chames.tn>

# Optional bot protection for sign-up, sign-in, and verification-email requests.
# Set both Turnstile keys to enforce it in production.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=printclub.chames.tn,localhost

# Optional Resend webhook signing secret (whsec_...) for permanent bounce suppression.
RESEND_WEBHOOK_SECRET=

# PostgreSQL is only reachable on the private Docker network.
POSTGRES_DB=printclub
POSTGRES_USER=printclub
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://printclub:replace-with-a-long-random-password@postgres:5432/printclub

# The Docker CIDR of the Traefik network, discovered with:
# docker network inspect traefik
TRUSTED_PROXY_IPS=172.18.0.0/16
