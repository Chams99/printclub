# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @optional @sensitive=false
# Comma-separated IPs/CIDRs for the reverse proxy in front of the app.
TRUSTED_PROXY_IPS=

# @optional @sensitive=false
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

# @optional @sensitive
RESEND_API_KEY=

# @optional @sensitive=false
EMAIL_FROM=

# @optional @sensitive
# When set, auth requests that can trigger verification mail require a valid
# Cloudflare Turnstile token from the web client.
TURNSTILE_SECRET_KEY=

# @optional @sensitive=false
# Comma-separated production hostnames accepted in Turnstile responses.
TURNSTILE_EXPECTED_HOSTNAMES=

# @optional @sensitive
# Resend webhook signing secret (whsec_...) used for permanent bounce events.
RESEND_WEBHOOK_SECRET=

# @type=string(minLength=1)
DATABASE_URL=
