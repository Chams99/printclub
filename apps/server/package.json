{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --env-file=.env --hot src/index.ts",
    "test": "bun test",
    "seed:dev-user": "bun --env-file=.env scripts/seed-dev-user.ts",
    "start": "bun --env-file=.env dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@PhotoPrinting/api": "workspace:*",
    "@PhotoPrinting/auth": "workspace:*",
    "@PhotoPrinting/db": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/trpc": "^1.1.0",
    "@hono/trpc-server": "^0.4.2",
    "drizzle-orm": "catalog:",
    "@sinclair/typebox": "^0.34.52",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "elysia": "^1.4.30",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@PhotoPrinting/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
